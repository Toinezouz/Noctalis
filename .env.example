# ---------------------------------------------------------------------------
# NOCTALIS — variables d'environnement
# Copier ce fichier en `.env` a la racine du projet.
#
# Aucune de ces variables n'est un secret : le projet n'en utilise aucun.
# ---------------------------------------------------------------------------

# Port d'ecoute du serveur HTTP + Socket.IO.
# En production, l'hebergeur le fournit lui-meme.
PORT=3001

# Environnement d'execution : "development" | "production" | "test"
NODE_ENV=development

# Origine(s) autorisee(s) pour CORS et Socket.IO, separees par des virgules.
# En production, c'est l'adresse publique du service.
CLIENT_URL=http://localhost:5173

# Duree (ms) pendant laquelle une observation est conservee apres la
# deconnexion des deux joueurs, pour permettre une reconnexion. 15 minutes.
ROOM_TTL_MS=900000

# --- Client (prefixe VITE_, lu au build) ------------------------------------
# Origine du serveur Socket.IO. Laisser vide quand le serveur sert lui-meme
# le client : ils partagent alors la meme origine.
VITE_SERVER_URL=
