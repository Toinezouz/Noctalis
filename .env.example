# ---------------------------------------------------------------------------
# GOT FIVE! - variables d'environnement
# Copier ce fichier en `.env` a la racine du projet.
# ---------------------------------------------------------------------------

# Port d'ecoute du serveur HTTP + Socket.IO
PORT=3001

# Environnement d'execution ("development" | "production" | "test")
NODE_ENV=development

# Origine(s) autorisee(s) pour CORS / Socket.IO (separees par des virgules)
CLIENT_URL=http://localhost:5173

# Duree (ms) pendant laquelle une partie est conservee apres la deconnexion
# des deux joueurs, afin de permettre une reconnexion.
ROOM_TTL_MS=900000

# --- Client (prefixe VITE_, lu au build par Vite) ---------------------------
# URL du serveur Socket.IO. Laisser vide en developpement : le client utilise
# alors le proxy Vite (meme origine).
VITE_SERVER_URL=
