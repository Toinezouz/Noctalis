# ---------------------------------------------------------------------------
# NOCTALIS — environment variables
# Copy this file to `.env` at the root of the project.
#
# None of these variables is a secret: the project uses none.
# ---------------------------------------------------------------------------

# Port of the HTTP + Socket.IO server.
# In production, the host provides it.
PORT=3001

# Runtime environment: "development" | "production" | "test"
NODE_ENV=development

# Allowed origin(s) for CORS and Socket.IO, comma-separated.
# In production, the public address of the service.
CLIENT_URL=http://localhost:5173

# How long (ms) a game is kept after everybody disconnected, so that people
# can come back. 15 minutes.
ROOM_TTL_MS=900000

# --- Client (VITE_ prefix, read at build time) -------------------------------
# Origin of the Socket.IO server. Leave empty when the server serves the
# client itself: they then share the same origin.
VITE_SERVER_URL=
